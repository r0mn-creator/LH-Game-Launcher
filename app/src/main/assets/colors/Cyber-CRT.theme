// Cyber-CRT  —  retro-futuristic terminal
// Classic phosphor displays meet modern dark-mode tooling: high contrast
// with an unmistakable arcade feel.
//
// Only the first four lines are required. Text is derived from --main when
// omitted; it is set here so the type carries a faint phosphor tint rather
// than being neutral white.

--main:           #0C0F0A;   // deep charcoal black
--secondary:      #1F2826;   // muted dark slate
--accent:         #32E0C4;   // electric terminal cyan
--highlight:      #EE4540;   // vibrant amber/coral red

--text:           #D8F2EA;   // cyan-tinted white
--text-secondary: #7FA79C;   // dimmed phosphor
