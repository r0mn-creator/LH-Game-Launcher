// Midnight Alloy  —  tactical / industrial
// Slate and steel blue with high-visibility warning orange.

--main:           #11161A;   // obsidian blue-grey
--secondary:      #1E252D;   // midnight steel
--accent:         #4A90E2;   // tactical blue
--highlight:      #FF6B00;   // industrial alert orange

--text:           #E6EDF5;   // cool white
--text-secondary: #8CA0B3;   // steel grey
